<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ibm.maven.plugins</groupId>
	<artifactId>ace-maven-plugin</artifactId>
	<version>12.0.11-SNAPSHOT</version>
	<packaging>maven-plugin</packaging>
	<name>ace-maven-plugin</name>
	<url>http://maven.apache.org</url>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
	</properties>
	<dependencies>
		<!-- inital dependencies from ace-maven-plugin java 8 -->
		<dependency>
			<groupId>org.apache.maven</groupId>
			<artifactId>maven-plugin-api</artifactId>
			<version>3.9.9</version>
			<scope>provided</scope>
			<!-- update 23/01/2025: 
			latest stable version: 3.9.9; released: Aug 17, 2024
			previous used version: 3.9.5
			tested with 4.0.0-rc-2 but not chosen as it's still a "release candidate" 
			vulnerabitis: 0; source: https://mvnrepository.com
			-->
		</dependency>
		<dependency>
			<!-- annotations are needed only to build the plugin -->
			<groupId>org.apache.maven.plugin-tools</groupId>
			<artifactId>maven-plugin-annotations</artifactId>
			<version>3.15.1</version>
			<!-- update 23/01/2025: 
			latest stable version: 3.15.1; released: Oct 25, 2024; 
			previous used version: 3.10.2
			vulnerabitis: 0; source: https://mvnrepository.com
			-->
			<scope>provided</scope>
		</dependency>
		<dependency>
			<!-- TODO -->
			<groupId>org.twdata.maven</groupId>
			<artifactId>mojo-executor</artifactId>
			<version>2.3.3</version>
			<!-- latest version 2.4.1-m2 by 21/11/2023; using 2.3.3 because of implementation / compatibility reasons -->
			<scope>compile</scope>
		</dependency>
		<dependency>
			<!-- used in plugins/ace/utils/ZipUtils.java only -->
			<groupId>org.apache.ant</groupId>
			<artifactId>ant</artifactId>
			<version>1.10.15</version>
			<!-- update 23/01/2025: 
			latest stable version: 1.10.15; released: Aug 29, 2024; 
			previous used version: 1.10.14
			vulnerabitis: 0; source: https://mvnrepository.com
			-->
		</dependency>
		<dependency>
			<!-- used in ace/mojos/PrepareBarBuildWorkspaceMojo.java only -->
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>2.11.5</version>
			<!-- update 23/01/2025: 
			latest stable version: 2.11.5; released: Feb 22, 2023; 
			previous used version: 2.11.5 (same one) 
			vulnerabitis: 0; source: https://mvnrepository.com
			-->
		</dependency>
		<!-- for junit tests -->
		<dependency>
			<!-- TODO - moving to org.junit.jupiter fails -->
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<!-- 
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.12.0</version>
			-->
		</dependency>
		<!-- new dependencies; required for cxf-xjc-plugin -->
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>3.0.1</version>
			<!-- to review -->
			<!-- update 26/02/2025:
				 latest version 2.4.0-b180830.0359 by 21/11/2023; using 2.3.1 as latest stable
				 TODO: moved to jakarta.xml.bind » jakarta.xml.bind-api -->
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>3.0.2</version>
			<scope>runtime</scope>
			<!-- to review -->
			<!-- update 26/02/2025:
			     latest version 4.0.5 by Mar 07, 2024; using 2.3.9 because of compatibility issues 
			-->
		</dependency>
		<dependency>
			<groupId>org.codehaus.mojo</groupId>
			<artifactId>jaxb2-maven-plugin</artifactId>
			<version>3.2.0</version>
			<!-- update 26/02/2025:
				 latest version 2.0.1 by 21/11/2023; no changes -->
		</dependency>
	</dependencies>
	<reporting>
		<plugins>
			<plugin>
				<!-- required for plugin site generation -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-plugin-plugin</artifactId>
				<version>3.15.1</version>
				<!-- update 26/02/2025: 
					 latest stable version: 3.15.1; released: Oct 25, 2024 
					 previous used version: 3.10.2 
					 vulnerabitis: 0; source: https://mvnrepository.com
				-->
			</plugin>
		</plugins>
	</reporting>
	<build>
		<plugins>
			<!--
			https://central.sonatype.com/artifact/org.apache.cxf/cxf-xjc-plugin/versions
			latest version 4.0.0; using 3.3.2 because of compatibility topics
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
			</plugin>
			
			<!-- used to generate the classes based on given xsds -->
			<plugin>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-xjc-plugin</artifactId>
				<version>4.1.0</version>
				<!-- update 26/02/2025: 
					 latest stable version: 4.1.0; released: Dec 06, 2024
					 not used because of compatibility issues 
					 using instead: 3.3.4; released: Aug 27, 2024
					 previous used version: 3.3.2
					 vulnerabitis: 0; source: https://mvnrepository.com
				-->
				<executions>
					<execution>
						<id>eclipse-xjc</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>xsdtojava</goal>
						</goals>
						<configuration>
							<xsdOptions>
								<xsdOption>
									<xsd>${basedir}/src/main/xsd/EclipseProject.xsd</xsd>
									<packagename>${project.groupId}.ace.generated.eclipse_project</packagename>
								</xsdOption>
							</xsdOptions>
						</configuration>
					</execution>
					<execution>
						<id>maven-xjc</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>xsdtojava</goal>
						</goals>
						<configuration>
							<xsdOptions>
								<xsdOption>
									<xsd>${basedir}/src/main/xsd/maven-v4_0_0.xsd</xsd>
									<packagename>${project.groupId}.ace.generated.maven_pom</packagename>
								</xsdOption>
							</xsdOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to generate the mojo plugin information -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-plugin-plugin</artifactId>
				<version>3.15.1</version>
				<!-- update 26/02/2025: 
					 latest stable version: 3.15.1; released: Oct 25, 2024 
					 previous used version: 3.10.2 
					 vulnerabitis: 0; source: https://mvnrepository.com
				-->
				<executions>
					<execution>
						<id>default-descriptor</id>
						<phase>process-classes</phase>
					</execution>
					<!-- if you want to generate help goal -->
					<execution>
						<id>help-goal</id>
						<goals>
							<goal>helpmojo</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to attach the source to the final jar file -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.3.1</version>
				<!-- update 26/02/2025: 
					 latest stable version: 3.3.1; Jul 01, 2024
					 previous used version: 3.3.0 
					 vulnerabitis: 0; source: https://mvnrepository.com
				-->
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to create the javadoc  -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.11.1</version>
				<!-- update 26/02/2025: 
					 latest stable version: 3.11.1; Dec 04, 2024
				-->
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<doclint>none</doclint>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to create a "maven site" (documentation root) -->
			<!-- -->
			<plugin>
				<artifactId>maven-site-plugin</artifactId>
				<version>4.0.0-M16</version>
				<!-- update 26/02/2025: 
					 latest stable version: 4.0.0-M16; Jul 20, 2024
					 previous used version: 3.3
					 vulnerabitis: 0; source: https://mvnrepository.com
				-->
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<!--This plugin's configuration is used to store Eclipse m2e settings 
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-project-info-reports-plugin</artifactId>
					<version>3.8.0</version>
					<!-- update 26/02/2025: 
					 latest stable version: 3.8.0; Oct 21, 2024
					 previous used version: 2.8
				    -->
				</plugin>
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<!-- update 26/02/2025: 
						 no changes as no new package available -->
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.apache.maven.plugins
										</groupId>
										<artifactId>
											maven-plugin-plugin
										</artifactId>
										<versionRange>
											[3.4,)
										</versionRange>
										<goals>
											<goal>descriptor</goal>
											<goal>helpmojo</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<execute/>
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.apache.maven.plugins
										</groupId>
										<artifactId>
											maven-compiler-plugin
										</artifactId>
										<!--27.02.2024: 3.14.0 is latest  -->
										<!-- 
										<versionRange>
											[2.5.1,)
										</versionRange> -->
										<version>3.14.0</version>
										<goals>
											<goal>testCompile</goal>
											<goal>compile</goal>
										</goals>
										<configuration>
											<compilerArgs>
												<arg>-verbose</arg>
												<arg>-Xlint:all,-options,-path</arg>
											</compilerArgs>
										</configuration>
									</pluginExecutionFilter>
									<action>
										<ignore/>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
