<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ibm.maven.plugins</groupId>
	<artifactId>ace-maven-plugin</artifactId>
	<version>12.0.11-SNAPSHOT</version>
	<packaging>maven-plugin</packaging>
	<name>ace-maven-plugin</name>
	<url>http://maven.apache.org</url>
	
	<!-- section 1: general properties --> 
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
	</properties>
	
	
	<!-- section 2: general build configuration / plugins --> 
	<build>
		
		<!-- section to set specific plugin versions, commands and configuration for the build --> 
		<plugins>
			<!-- used for compile and resource management  -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<!-- update 26/05/2026:
					 latest stable version: 3.15.0; released: Feb 1, 2026
					 previous used version: 3.14.0
				-->
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.5.0</version>
				<!-- update 26/05/2026:
					 latest stable version: 3.5.0; released: March 5, 2026
					 previous used version: 3.3.1
				-->
			</plugin>
			
			<!-- used to generate the classes based on given xsds -->
			<plugin>
				<groupId>org.apache.cxf</groupId>
				<artifactId>cxf-xjc-plugin</artifactId>
				<version>4.2.0</version>
				<!-- update 26/05/2026:
					 latest stable version: 4.2.0; released: May 07, 2026
					 previous used version: 4.1.0
				-->
				<executions>
					<execution>
						<id>eclipse-xjc</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>xsdtojava</goal>
						</goals>
						<configuration>
							<xsdOptions>
								<xsdOption>
									<xsd>${basedir}/src/main/xsd/EclipseProject.xsd</xsd>
									<packagename>${project.groupId}.ace.generated.eclipse_project</packagename>
								</xsdOption>
							</xsdOptions>
						</configuration>
					</execution>
					<execution>
						<id>maven-xjc</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>xsdtojava</goal>
						</goals>
						<configuration>
							<xsdOptions>
								<xsdOption>
									<xsd>${basedir}/src/main/xsd/maven-v4_0_0.xsd</xsd>
									<packagename>${project.groupId}.ace.generated.maven_pom</packagename>
								</xsdOption>
							</xsdOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to generate the mojo plugin information -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-plugin-plugin</artifactId>
				<version>3.15.1</version>
				<!-- update 26/02/2025: 
					 latest stable version: 3.15.1; released: Oct 25, 2026
					 previous used version: 3.10.2 
				-->
				<executions>
					<execution>
						<id>default-descriptor</id>
						<phase>process-classes</phase>
					</execution>
					<!-- if you want to generate help goal -->
					<execution>
						<id>help-goal</id>
						<goals>
							<goal>helpmojo</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to attach the source to the final jar file -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>
				<!-- update 26/05/2026:
					 latest stable version: 3.4.0; Nov 29, 2025
					 previous used version: 3.3.1
				-->
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to create the javadoc  -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<!-- update 26/05/2026:
					 latest stable version: 3.12.0; Sep 21, 2025
					 previous used version: 3.11.1
				-->
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<doclint>none</doclint>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- plugin to create a "maven site" (documentation root) -->
			<!-- -->
			<plugin>
				<artifactId>maven-site-plugin</artifactId>
				<version>4.0.0-M16</version>
				<!-- update 26/02/2025: 
					 latest stable version: 4.0.0-M16; Jul 20, 2024
					 previous used version: 3.3
				-->
			</plugin>
		</plugins>
		<!-- section to define the plugin management --> 
		<pluginManagement>
			<plugins>
				<!-- make sure that the latest maven-dependency-plugin is used --> 
				<plugin>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>3.10</version>
				</plugin>
				<!-- update 26/05/2026: 
					latest version: 3.10
				--> 
				<!--This plugin's configuration is used to store Eclipse m2e settings 
					only. It has no influence on the Maven build itself. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-project-info-reports-plugin</artifactId>
					<version>3.9.0</version>
					<!-- update 26/05/2026:
					 latest stable version: 3.9.0; Feb 26, 2025
					 previous used version: 3.8.0
				    -->
				</plugin>
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<!-- update 26/02/2025: 
						 no changes as no new package available -->
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.apache.maven.plugins
										</groupId>
										<artifactId>
											maven-plugin-plugin
										</artifactId>
										<versionRange>
											[3.4,)
										</versionRange>
										<goals>
											<goal>descriptor</goal>
											<goal>helpmojo</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<execute/>
									</action>
								</pluginExecution>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.apache.maven.plugins</groupId>
										<artifactId>maven-compiler-plugin</artifactId>
										<versionRange>
											[2.5.1,)
										</versionRange> -->
										<goals>
											<goal>testCompile</goal>
											<goal>compile</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore/>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	
	<!-- section 3: list of required dependencies for the build --> 
	
	<dependencies>
		<dependency>
			<groupId>org.apache.maven</groupId>
			<artifactId>maven-plugin-api</artifactId>
			<version>3.9.16</version>
			<scope>provided</scope>
			<!-- update 27/05/2026:
			latest stable version: 3.9.16; released: May 18, 2026
			previous used version: 3.9.9
			-->
		</dependency>
		<dependency>
			<!-- annotations are needed only to build the plugin -->
			<groupId>org.apache.maven.plugin-tools</groupId>
			<artifactId>maven-plugin-annotations</artifactId>
			<version>3.15.2</version>
			<!-- update 23/01/2025: 
			latest stable version: 3.15.2; released: Oct 24, 2025 
			previous used version: 3.15.1
			-->
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.twdata.maven</groupId>
			<artifactId>mojo-executor</artifactId>
			<version>2.4.1</version>
			<!-- update 26/05/2026:
			latest stable version: 2.4.1; released: Jan 09, 2025;
			previous used version: 2.3.3
			-->
			<scope>compile</scope>
		</dependency>
		<dependency>
			<!-- used in plugins/ace/utils/ZipUtils.java only -->
			<groupId>org.apache.ant</groupId>
			<artifactId>ant</artifactId>
			<version>1.10.17</version>
			<!-- update 26/05/2026:
			latest stable version: 1.10.17; released: Apr 06, 2026
			previous used version: 1.10.15
			-->
		</dependency>
		<dependency>
			<!-- used in ace/mojos/PrepareBarBuildWorkspaceMojo.java only -->
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>2.11.6</version>
			<!-- update 26/05/2026:
			latest stable version: 2.11.6; released: Feb 11, 2026;
			previous used version: 2.11.5
			-->
		</dependency>
		<!-- for junit tests -->
		<dependency>
			<!-- TODO - moving to org.junit.jupiter fails -->
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<!-- 
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.12.0</version>
			-->
		</dependency>
		<!-- new dependencies; required for cxf-xjc-plugin -->
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>4.1.0-M1</version>
			<!-- update 26/05/2026:
				latest stable version: 4.1.0-M1; released: May, 2026
				previous used version: 4.0.2
			-->
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>4.0.8</version>
			<scope>runtime</scope>
			<!-- update 26/05/2026:
			     latest stable version: 4.0.8; released: May 06, 2026
				 previous used version: 3.0.2
			-->
		</dependency>
		<dependency>
			<groupId>org.codehaus.mojo</groupId>
			<artifactId>jaxb2-maven-plugin</artifactId>
			<version>4.1.0</version>
			<!-- update 26/05/2026:
				 latest stable version: 4.1.0; released: Jan 19, 2026
				 previous used version: 3.2.0  -->
		</dependency>
		<!-- https://mvnrepository.com/artifact/commons-io/commons-io -->
		<dependency>
		  		<groupId>commons-io</groupId>
		  		<artifactId>commons-io</artifactId>
		  		<version>2.22.0</version>
			<!-- update 26/05/2026:
				latest stable version: 2.22.0; released: Apr 19, 2026
				previous used version: 2.18.0 -->
		</dependency>
		
		<!-- set provided scope for maven plugins - used by the code generation -->
		<dependency>
		  		<groupId>org.apache.maven</groupId>
		  		<artifactId>maven-model</artifactId>
			<version>3.9.16</version>
		  		<scope>provided</scope>
			<!-- update 27/05/2026:
				latest stable version: 3.9.16, released: May 2026
				previous used version: 3.9.9-->
		</dependency>
		<dependency>
		  		<groupId>org.apache.maven</groupId>
		  		<artifactId>maven-core</artifactId>
			<version>3.9.16</version>
		  		<scope>provided</scope>
			<!-- update 27/05/2026:
				latest stable version: 3.9.16, released: May 18, 2026
				previous used version: 3.9.9-->
		</dependency>
	</dependencies>
	<reporting>
		<plugins>
			<plugin>
				<!-- required for plugin site generation -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-plugin-plugin</artifactId>
				<version>3.15.2</version>
				<!-- update 26/05/2026:
					 latest stable version: 3.15.2; released: October 2026
					 (no newer stable version available for Maven 3.6.3)
					 previous used version: 3.15.1
				-->
			</plugin>
		</plugins>
	</reporting>
</project>
